// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 // binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  EMPLOYEE
  CUSTOMER
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique 
  password  String
  role      String    @default("user")
  date      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt	
  
  orders   SalesOrder[]
  purchases PurchaseOrder[]

  // optional, because not every user is an employe	
  employee  Employee? 
  customer  Customer? 
  return    Return[]
  payment   Payment[]
  otherIncomes OtherIncome[]
  expense   Expense[]
}

model Employee {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  phone      String?
  ghCard     String?
  license    String?
  email      String?  @unique
  address    String
  salary     Int
  position   String?
  isAdmin    Boolean  @default(false)
  isActive   Boolean  @default(true)
  deletedAt  DateTime?
  date       DateTime
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id])

  orders     SalesOrder[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Customer {
  id             Int      @id @default(autoincrement())
  businessName   String?
  contactPerson  String
  phone          String?
  ghCard         String?
  location       String
  date           DateTime
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id])

  orders         SalesOrder[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Deposit {
  id             Int      @id @default(autoincrement())
  check          Decimal? @db.Decimal(10,2)
  cash           Decimal? @db.Decimal(10,2)
  amount         Decimal  @db.Decimal(10,2)
  date           DateTime
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Expense {
  id             Int      @id @default(autoincrement())
  autoMaint      Decimal? @db.Decimal(10,2)
  fuelAndOil     Decimal? @db.Decimal(10,2)
  salaries       Decimal? @db.Decimal(10,2)
  homeMaint      Decimal? @db.Decimal(10,2)
  sundry         Decimal? @db.Decimal(10,2)
  date           DateTime

  userId         Int
  user           User     @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SalesOrder {
  id            Int               @id @default(autoincrement())
  orderNumber   String            @unique
  orderDate     DateTime
  orderType     OrderType
  status        String            @default("pending")

  //Who created the order (always required)
  createdById   Int
  createdBy     User              @relation(fields: [createdById], references: [id])

  //If it's a CUSTOMER order
  customerId    Int?
  customer      Customer?          @relation(fields: [customerId], references: [id])

  //If it's an EMPLOYEE-issued order
  employeeId    Int?
  employee      Employee?          @relation(fields: [employeeId], references: [id])

  items         SalesOrderItem[]   //@relation(onDelete: Cascade)
  payments      Payment[]        

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  //indexes
  @@index([customerId])
  @@index([employeeId])
  @@index([createdById])
  @@index([orderDate])
  @@index([status])
  @@index([customerId, orderDate])
}

model Price {
  id            Int      @id @default(autoincrement())
  product       String
  exFactory     Decimal  @db.Decimal(10,3)
  retail        Decimal  @db.Decimal(10,3)

  salesItems    SalesOrderItem[]
  purchaseItems PurchaseOrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}

model Return {
  id               Int            @id @default(autoincrement())
  returnDate       DateTime

  salesOrderItemId Int
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  qtyReturned      Decimal        @db.Decimal(10,3)

  userId           Int
  user             User           @relation(fields: [userId], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  //indexes
  @@index([salesOrderItemId])
  @@index([userId])
  @@index([returnDate])
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  saleOrderDate DateTime
  product      String
  qty          Decimal    @db.Decimal(10,3)
  unitPrice    Decimal    @db.Decimal(10,2)
  amount       Decimal    @db.Decimal(10,2)

  priceId     Int?
  price       Price? @relation(fields: [priceId], references: [id])

  return      Return[]   
  empty       Empty[]     //@relation(onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  //indexes
  @@index([salesOrderId])
  @@index([priceId])
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  invoiceNumber String              @unique
  invoiceDate   DateTime

  items         PurchaseOrderItem[]
  payments      Payment[]

  userId          Int
  user            User            @relation(fields: [userId], references: [id])

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  //index
  @@index([invoiceDate])
}

model PurchaseOrderItem {
  id               Int            @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  orderDate        DateTime
  product          String
  qty              Decimal        @db.Decimal(10,3)
  unitPrice        Decimal        @db.Decimal(10,2)
  amount           Decimal        @db.Decimal(10,2)

  priceId          Int?
  price            Price?         @relation(fields: [priceId], references: [id])

  empty            Empty[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  //indexes
  @@index([purchaseOrderId])
  @@index([priceId])
}

model Payment {
  id              Int             @id @default(autoincrement())
  paymentDate     DateTime

  salesOrderId    Int?
  salesOrder      SalesOrder?     @relation(fields: [salesOrderId], references: [id])

  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])

  amountDue       Decimal   @db.Decimal(10,2)
  amountPaid      Decimal   @db.Decimal(10,2)
  amountBalance   Decimal   @db.Decimal(10,2)

  checkDate       DateTime?
  checkNumber     Int?
  loadNumber      String?
  carNumber       String?

  totalAmountBal  Decimal? @db.Decimal(10,2)
  totalEmptiesBal Decimal? @db.Decimal(10,3)

  emptiesDue      Decimal?        @db.Decimal(10,3)
  emptiesRec      Decimal?        @db.Decimal(10,3)
  emptiesBal      Decimal?        @db.Decimal(10,3)

  userId          Int
  user            User            @relation(fields: [userId], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  //indexes
  @@index([salesOrderId])
  @@index([purchaseOrderId])
  @@index([userId])
  @@index([paymentDate])
  @@index([salesOrderId, paymentDate])
}

model Empty {
  id           Int        @id @default(autoincrement())
  product      String     // Which product this empty belongs to
  
  purchaseItemId Int?     // optional link if received from supplier
  purchaseItem PurchaseOrderItem? @relation(fields: [purchaseItemId], references: [id])

  salesItemId  Int?       // optional link if sold to customer
  salesItem    SalesOrderItem? @relation(fields: [salesItemId], references: [id], onDelete: Cascade)

  qty          Decimal    @db.Decimal(10,3)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  //indexes
  @@index([purchaseItemId])
  @@index([salesItemId])
}

model Debit {
  id           Int        @id @default(autoincrement())
  date		   DateTime 
  description  String  
  checkNumber  Int
  amount       Decimal         @db.Decimal(10,2)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model OtherIncome {
  id          Int       @id @default(autoincrement())
  description String
  amount      Decimal   @db.Decimal(10,2)
  incomeDate  DateTime

  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([incomeDate])
}